{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompetitorCard",
  "description": "单个竞品调研产出的结构化卡片。每个 case 跑完后用此 schema 校验完整度。",
  "type": "object",
  "required": [
    "name",
    "company",
    "website",
    "one_liner",
    "core_features",
    "pricing_tiers",
    "positive_reviews",
    "negative_reviews",
    "sources"
  ],
  "properties": {
    "name": { "type": "string", "description": "竞品名" },
    "company": { "type": ["string", "null"] },
    "website": { "type": "string", "format": "uri" },
    "one_liner": { "type": "string", "description": "一句话定位" },

    "founded": { "type": ["string", "null"], "description": "成立年份" },
    "headquarters": { "type": ["string", "null"] },
    "team_size": { "type": ["string", "null"], "description": "如 '50-200'" },

    "core_features": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 3,
      "maxItems": 8,
      "description": "3-8 个杀手锏功能"
    },
    "feature_flags": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["full", "partial", "none", "unknown"]
      },
      "description": "用于功能矩阵的标准化能力标记；信息缺失用 unknown 而非 none"
    },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "integrations": { "type": "array", "items": { "type": "string" } },

    "pricing_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "price", "limits", "source_url"],
        "properties": {
          "name": { "type": "string", "description": "如 Free / Pro / Enterprise" },
          "price": { "type": "string", "description": "如 '$10/user/mo' / 'Contact sales' / '未公开'" },
          "limits": { "type": "string", "description": "如 '5 users max' / null 时填 '未公开'" },
          "source_url": { "type": "string", "format": "uri", "description": "该套餐价格的引用 URL，最好是官网 pricing 页" }
        }
      }
    },
    "business_model": { "type": ["string", "null"] },
    "target_audience": { "type": "array", "items": { "type": "string" } },
    "funding": {
      "type": ["object", "null"],
      "properties": {
        "amount": { "type": ["string", "null"], "description": "如 '$140M total'" },
        "round": { "type": ["string", "null"], "description": "如 'Series D'" },
        "date": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "notable_customers": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },

    "positive_reviews": {
      "type": "array",
      "items": { "type": "string" },
      "description": "用户好评关键点，不能为空"
    },
    "negative_reviews": {
      "type": "array",
      "items": { "type": "string" },
      "description": "用户差评 / 痛点（机会所在）；若评价不足必须显式声明 'review_insufficient'"
    },
    "growth_signals": {
      "type": "array",
      "items": { "type": "string" },
      "description": "招聘 / 社区活跃 / Google Trends 等增长信号"
    },

    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "title", "used_for"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "publisher": { "type": ["string", "null"] },
          "fetched_at": { "type": "string", "format": "date-time" },
          "type": {
            "type": "string",
            "enum": ["official_page", "pricing", "blog", "review_site", "social", "news", "other"]
          },
          "snippet": { "type": ["string", "null"], "maxLength": 500 },
          "used_for": {
            "type": "array",
            "items": { "type": "string" },
            "description": "本来源被用于哪些字段，如 ['pricing', 'feature_matrix', 'negative_reviews']"
          }
        }
      },
      "minItems": 2,
      "description": "每个竞品至少 2 个来源，其中至少 1 个 type=official_page 或 pricing"
    },

    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "未能获取或时效存疑的字段，让综合 agent 知道"
    }
  }
}
